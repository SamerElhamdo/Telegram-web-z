{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "tsBuildInfoFile": ".cache/.tsconfig.server.tsbuildinfo",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/shared/sessionBridge.ts"
  ]
}
