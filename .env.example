# Environment
NODE_ENV=development
APP_ENV=development

# Telegram API credentials (obtain from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public web app URL (e.g. https://tg.example.com/)
BASE_URL=
PUBLIC_ORIGIN=

# Backend server & runtime
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
TRUST_PROXY=false
REQUIRE_HTTPS=false
# Use "gramjs" for real WSS MTProto or "mock" for safe local simulation/testing
TELEGRAM_RUNTIME_MODE=gramjs
ACCOUNT_OWNER_ID=primary-owner

# Required strong secrets (generate 32+ random bytes each; keep completely separate)
# Example: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
ADMIN_AUTH_TOKEN=
MCP_AUTH_TOKEN=
# Optional previous MCP token during zero-downtime rotation
MCP_AUTH_TOKEN_PREVIOUS=

# Comma-separated allowed browser origins for MCP Streamable HTTP (DNS rebinding protection)
MCP_ALLOWED_ORIGINS=

# Reverse proxy (Caddy) domain for private hosting HTTPS
APP_DOMAIN=
ACME_EMAIL=
